# .env.example — copy to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real tokens or real account numbers, and
# never paste a working credential into this template: a PAT that appears in
# plaintext anywhere in a repository is treated as leaked and is auto-revoked.

# ── NoneBot core ───────────────────────────────────────────────────────────

# dev | prod. Controls which .env.<name> file NoneBot also loads.
ENVIRONMENT=dev

# ASGI driver. `~fastapi` serves both the OneBot WebSocket and an HTTP endpoint.
DRIVER=~fastapi

# Keep localstore data (logs, caches) inside the project instead of the OS
# profile directory, which makes containers and CI behave predictably.
LOCALSTORE_USE_CWD=true

# true | false
DEBUG=false

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ── OneBot v11 connection ──────────────────────────────────────────────────
#
# The bot LISTENS here; your QQ client (e.g. NapCatQQ) connects to it as a
# reverse-WebSocket client at ws://<HOST>:<PORT>/onebot/v11/
HOST=127.0.0.1
PORT=8080

# Shared secret for the OneBot connection. The value is used both to validate
# inbound WebSocket clients and to authenticate outbound API calls, so it must
# match the token configured in your QQ client exactly. A mismatch is rejected
# at the handshake with HTTP 403 and retried every 30s.
#
# Leave empty to disable authentication (local development only).
ONEBOT_V11_ACCESS_TOKEN=

# ── Command parsing ────────────────────────────────────────────────────────

# Characters that may start a command.
COMMAND_START=["/", ".", ","]

# ── Optional tooling ───────────────────────────────────────────────────────

# Only needed if you script GitHub issue/PR automation locally. The bot itself
# never reads this. Prefer a short-lived, minimum-scope token, and keep it in
# the gitignored `.env` — never in this template.
GITHUB_TOKEN=
